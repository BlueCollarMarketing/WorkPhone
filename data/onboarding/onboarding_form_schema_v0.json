    "hours_weekday_close": {"type": "time", "group": "hours"},
    "hours_saturday": {"type": "string", "group": "hours"},
    "hours_sunday": {"type": "string", "group": "hours"},
    "after_hours_mode": {"type": "enum", "group": "hours", "values": ["answer", "voicemail", "forward"]},
    "voice_id": {"type": "string", "group": "voice"},
    "voice_style": {"type": "enum", "group": "voice", "values": ["neutral", "friendly", "formal"]},
    "greeting_template": {"type": "string", "group": "voice"}
